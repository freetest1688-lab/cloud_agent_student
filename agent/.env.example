# OpenAI API key (required, used for both LLM and embeddings)
OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-OWN-KEY
EMBEDDING_MODEL=text-embedding-3-small
# Optional: override the OpenAI-compatible endpoint (Azure OpenAI / proxy / compatible services)
# BASE_URL=https://api.openai.com/v1

# Optional: only required when using the qwen-image-2.0 poster-generation MCP tool
# DASHSCOPE_API_KEY=

# Redis configuration (short-term memory; optional)
REDIS_URL=redis://default:Yoxxxxxx@127.0.0.1:6379
REDIS_TTL=1800

# Milvus configuration (long-term memory; optional)
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_API_KEY=

# MySQL configuration (used by BillingAgent / FinOpsAgent for orders, billing, instance queries)
# Leaving these empty or as placeholders will cause billing/finops tool calls to fail.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=cloudpass
MYSQL_DATABASE=cloud_platform

# Neo4j configuration (knowledge graph; optional)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# Log level
LOG_LEVEL=INFO

